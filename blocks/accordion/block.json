{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pixelcore/accordion",
	"title": "PixelCore Accordion",
	"category": "pixelcore",
	"icon": "list-view",
	"description": "FAQ / acordeón con múltiples items; cada item admite cualquier bloque de Gutenberg como contenido.",
	"textdomain": "capixel-components",
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"allowMultiple": { "type": "boolean", "default": false },
		"iconPosition": { "type": "string", "default": "right" },
		"animation": {
			"type": "object",
			"default": { "preset": "none", "trigger": "scroll" }
		}
	},
	"style": "pixelcore-css",
	"editorStyle": "pixelcore-editor-css",
	"viewScript": "pixelcore-js",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
